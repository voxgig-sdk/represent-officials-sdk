# BasicRepresentativeFlow

main: kit: flow: BasicRepresentativeFlow:
{
  entity: "representative",
  kind: "basic",
  name: "BasicRepresentativeFlow",
  step: [
    {
      m: {
        boundary: "boundary01",
        boundary_set: "boundary_set01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "representative_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "representative_ref01",
        srcdatavar: "representative_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "representative01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-representative_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicRepresentativeFlow"
}